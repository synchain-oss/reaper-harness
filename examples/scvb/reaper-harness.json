{
  "$schema": "../../schema/config.schema.json",
  "schema": 1,
  "name": "scvb",
  "notes": "Example: SCVB v0.10.0-beta.1 (SCVB Input on each vocal track, SCVB Output first on the vocal bus, SCVB Monitor read only). Passthrough part: every instance in its default state (no Input has a channel), where the plugins leave the audio untouched. Routing part: Inputs with channels 1..3 and an Output in group 8, states taken from routing-template.rpp, judged by levels (the master within 0.5 dB RMS of dry, each vocal track at least 6 dB below dry because its Input silences it; a second render judged by the same master levels, its vocal tracks to within -400 dBFS; every FX bypassed bit-identical to dry; save and reopen with every FX bypassed); its online render is not judged. See docs/INTEGRATING.md.",
  "plugins": {
    "input": {
      "bundle": "SCVB Input.vst3",
      "states": {
        "ch1": { "template": "routing-template.rpp", "track": "Vox 1", "fx": 1 },
        "ch2": { "template": "routing-template.rpp", "track": "Vox 2", "fx": 1 },
        "ch3": { "template": "routing-template.rpp", "track": "Vox 3", "fx": 1 }
      }
    },
    "output": {
      "bundle": "SCVB Output.vst3",
      "states": { "group-8": { "template": "routing-template.rpp", "track": "Bus", "fx": 1 } }
    },
    "monitor": {
      "bundle": "SCVB Monitor.vst3",
      "states": { "group-8": { "template": "routing-template.rpp", "track": "Bus", "fx": 2 } }
    }
  },
  "signal": { "seconds": 4, "seed": 1, "noiseDb": -20 },
  "layouts": {
    "monitor": { "tracks": [ { "name": "Voice", "source": true, "fx": [ { "plugin": "monitor" } ] } ] },
    "input": { "tracks": [ { "name": "Voice", "source": true, "fx": [ { "plugin": "input" } ] } ] },
    "output": {
      "tracks": [
        { "name": "Bus", "source": false, "folder": true, "fx": [ { "plugin": "output" } ] },
        { "name": "Voice", "source": true, "parent": "Bus" }
      ]
    },
    "system": {
      "tracks": [
        { "name": "Bus", "source": false, "folder": true, "fx": [ { "plugin": "output" }, { "plugin": "monitor" } ] },
        { "name": "Vox 1", "source": true, "parent": "Bus", "signal": { "seed": 11 }, "fx": [ { "plugin": "input" } ] },
        { "name": "Vox 2", "source": true, "parent": "Bus", "signal": { "seed": 12 }, "fx": [ { "plugin": "input" } ] },
        { "name": "Vox 3", "source": true, "parent": "Bus", "signal": { "seed": 13 }, "fx": [ { "plugin": "input" } ] }
      ]
    },
    "system-params": {
      "tracks": [
        { "name": "Bus", "source": false, "folder": true, "fx": [ { "plugin": "output", "params": { "Width": { "normalized": 0.5, "display": "75 %" }, "MS Balance": { "normalized": 0.75, "display": "S50" } } }, { "plugin": "monitor" } ] },
        { "name": "Vox 1", "source": true, "parent": "Bus", "signal": { "seed": 11 }, "fx": [ { "plugin": "input" } ] },
        { "name": "Vox 2", "source": true, "parent": "Bus", "signal": { "seed": 12 }, "fx": [ { "plugin": "input" } ] },
        { "name": "Vox 3", "source": true, "parent": "Bus", "signal": { "seed": 13 }, "fx": [ { "plugin": "input" } ] }
      ]
    },
    "system-quiet": {
      "tracks": [
        { "name": "Bus", "source": false, "folder": true, "fx": [ { "plugin": "output" }, { "plugin": "monitor" } ] },
        { "name": "Vox 1", "source": true, "parent": "Bus", "signal": { "seed": 11 }, "fx": [ { "plugin": "input" } ] },
        { "name": "Vox 2", "source": true, "parent": "Bus", "signal": { "seed": 12 }, "volume": 0.5, "fx": [ { "plugin": "input" } ] },
        { "name": "Vox 3", "source": true, "parent": "Bus", "signal": { "seed": 13 }, "fx": [ { "plugin": "input" } ] }
      ]
    },
    "routing": {
      "tracks": [
        { "name": "Bus", "source": false, "folder": true, "fx": [ { "plugin": "output", "state": "group-8" }, { "plugin": "monitor", "state": "group-8" } ] },
        { "name": "Vox 1", "source": true, "parent": "Bus", "signal": { "seed": 11 }, "fx": [ { "plugin": "input", "state": "ch1" } ] },
        { "name": "Vox 2", "source": true, "parent": "Bus", "signal": { "seed": 12 }, "fx": [ { "plugin": "input", "state": "ch2" } ] },
        { "name": "Vox 3", "source": true, "parent": "Bus", "signal": { "seed": 13 }, "fx": [ { "plugin": "input", "state": "ch3" } ] }
      ]
    }
  },
  "scenarios": [
    { "id": "monitor", "kind": "render", "layout": "monitor", "matrix": { "mode": ["offline", "1x"], "sr": [44100, 48000], "block": [64, 1024] } },
    { "id": "monitor-mono", "kind": "render", "layout": "monitor", "mono": true },
    { "id": "monitor-bypass", "kind": "render", "layout": "monitor", "bypass": true },
    { "id": "input", "kind": "render", "layout": "input", "matrix": { "mode": ["offline", "1x"], "sr": [44100, 48000], "block": [64, 1024] } },
    { "id": "input-mono", "kind": "render", "layout": "input", "mono": true },
    { "id": "input-bypass", "kind": "render", "layout": "input", "bypass": true },
    { "id": "output", "kind": "render", "layout": "output", "matrix": { "sr": [44100, 48000] } },
    { "id": "output-bypass", "kind": "render", "layout": "output", "bypass": true },
    { "id": "system", "kind": "render", "layout": "system", "matrix": { "mode": ["offline", "1x", "online"] } },
    { "id": "system-repeat", "kind": "render", "layout": "system", "compare": "repeat" },
    { "id": "system-params", "kind": "render", "layout": "system-params" },
    { "id": "system-bypass", "kind": "render", "layout": "system", "bypass": true },
    { "id": "system-device", "kind": "device", "layout": "system-params", "matrix": { "sr": [44100, 48000], "block": [64, 1024] } },
    { "id": "monitor-reopen", "kind": "savereopen", "layout": "monitor" },
    { "id": "input-reopen", "kind": "savereopen", "layout": "input" },
    { "id": "system-reopen", "kind": "savereopen", "layout": "system-params", "cycles": 3 },
    { "id": "instances", "kind": "instances", "plugins": ["monitor", "input", "output"] },
    { "id": "routing", "kind": "render", "layout": "routing", "matrix": { "mode": ["offline", "1x"] }, "maxDiffDb": 12, "rmsChangeDb": { "L": [-0.5, 0.5], "R": [-0.5, 0.5] },
      "stems": [ { "track": "Vox 1", "rmsChangeDb": { "L": [-400, -6], "R": [-400, -6] } }, { "track": "Vox 2", "rmsChangeDb": { "L": [-400, -6], "R": [-400, -6] } }, { "track": "Vox 3", "rmsChangeDb": { "L": [-400, -6], "R": [-400, -6] } } ] },
    { "id": "routing-blocks", "kind": "render", "layout": "routing", "matrix": { "sr": [44100, 48000], "block": [64, 1024] }, "maxDiffDb": 12, "rmsChangeDb": { "L": [-0.5, 0.5], "R": [-0.5, 0.5] },
      "stems": [ { "track": "Vox 1", "rmsChangeDb": { "L": [-400, -6], "R": [-400, -6] } }, { "track": "Vox 2", "rmsChangeDb": { "L": [-400, -6], "R": [-400, -6] } }, { "track": "Vox 3", "rmsChangeDb": { "L": [-400, -6], "R": [-400, -6] } } ] },
    { "id": "routing-repeat", "kind": "render", "layout": "routing", "compare": "repeat", "maxDiffDb": 12, "rmsChangeDb": { "L": [-0.5, 0.5], "R": [-0.5, 0.5] },
      "stems": [ { "track": "Vox 1", "maxDiffDb": -400 }, { "track": "Vox 2", "maxDiffDb": -400 }, { "track": "Vox 3", "maxDiffDb": -400 } ] },
    { "id": "routing-bypass", "kind": "render", "layout": "routing", "bypass": true, "stems": ["Vox 1", "Vox 2", "Vox 3"] },
    { "id": "routing-device", "kind": "device", "layout": "routing" },
    { "id": "routing-reopen", "kind": "savereopen", "layout": "routing", "bypass": true, "cycles": 3 }
  ],
  "negative": [
    { "id": "neg-system-quieter-track", "kind": "render", "layout": "system-quiet", "compare": { "layout": "system" }, "expect": "FAIL", "expectDetail": "^identical=no lag=0 " },
    { "id": "neg-passthrough-is-not-routing", "kind": "render", "layout": "system", "stems": [ { "track": "Vox 1", "rmsChangeDb": { "L": [-400, -6], "R": [-400, -6] } } ],
      "expect": "FAIL", "expectDetail": "\\| stem Vox 1: .*failed: rms change L " }
  ],
  "extensions": { "modules": ["scvb-preflight.psm1"] }
}
